#!/bin/sh

WIFI_INTERFACE="wlan0"
WIFI_CONFIG="/etc/wpa_supplicant.conf"
WIFI_CTRL_DIR="/run/wpa_supplicant"
WIFI_PID_FILE="/run/wpa_supplicant.${WIFI_INTERFACE}.pid"
DHCP_PID_FILE="/run/udhcpc.${WIFI_INTERFACE}.pid"

case "$1" in
    start)
        printf "Starting Wi-Fi: "

        if [ ! -r "$WIFI_CONFIG" ]; then
            echo "missing $WIFI_CONFIG"
            exit 1
        fi

        # The Wi-Fi driver is loaded asynchronously during boot.
        for i in $(seq 1 100); do
            [ -d "/sys/class/net/$WIFI_INTERFACE" ] && break
            usleep 100000
        done

        if [ ! -d "/sys/class/net/$WIFI_INTERFACE" ]; then
            echo "interface unavailable"
            exit 1
        fi

        mkdir -p "$WIFI_CTRL_DIR"
        ip link set "$WIFI_INTERFACE" up || exit 1

        if ! wpa_cli -p "$WIFI_CTRL_DIR" -i "$WIFI_INTERFACE" ping 2>/dev/null | grep -q PONG; then
            wpa_supplicant -B -i "$WIFI_INTERFACE" -c "$WIFI_CONFIG" \
                -C "$WIFI_CTRL_DIR" -P "$WIFI_PID_FILE" || exit 1
        fi

        # Let association start before requesting a lease. udhcpc continues
        # retrying in the background if the access point is not ready yet.
        for i in $(seq 1 100); do
            if wpa_cli -p "$WIFI_CTRL_DIR" -i "$WIFI_INTERFACE" status 2>/dev/null \
                | grep -q '^wpa_state=COMPLETED$'; then
                break
            fi
            usleep 100000
        done

        if [ ! -r "$DHCP_PID_FILE" ] || ! kill -0 "$(cat "$DHCP_PID_FILE")" 2>/dev/null; then
            udhcpc -b -i "$WIFI_INTERFACE" -p "$DHCP_PID_FILE" &
        fi

        echo "started"
        ;;
    stop)
        if [ -r "$DHCP_PID_FILE" ]; then
            kill "$(cat "$DHCP_PID_FILE")" 2>/dev/null || true
            rm -f "$DHCP_PID_FILE"
        fi
        if [ -r "$WIFI_PID_FILE" ]; then
            kill "$(cat "$WIFI_PID_FILE")" 2>/dev/null || true
            rm -f "$WIFI_PID_FILE"
        fi
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
