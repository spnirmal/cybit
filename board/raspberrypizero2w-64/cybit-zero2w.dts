/dts-v1/;
/plugin/;

/ {
    compatible = "brcm,bcm2835";

    /* 1. Configure SoC internal pull-ups */
    fragment@0 {
        target = <&gpio>;
        __overlay__ {
            cybit_pins: cybit_pins {
                brcm,pins = <5 6 26>;
                brcm,function = <0>; /* 0 = Input */
                brcm,pull = <2>;     /* 2 = Pull-up (0 = none, 1 = down) */
            };
        };
    };

    /* 2. Instantiate the driver node */
    fragment@1 {
        target-path = "/";
        __overlay__ {
            cybit_rotary: cybit_rotary {
                compatible = "custom,cybit-rotary";
                pinctrl-names = "default";
                pinctrl-0 = <&cybit_pins>;
                status = "okay";

                /* Flags: 1 = Active Low (contacts short to GND) */
                a-gpios      = <&gpio 5 1>;
                b-gpios      = <&gpio 6 1>;
                button-gpios = <&gpio 26 1>;
            };
        };
    };
};
